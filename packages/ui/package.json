{
  "name": "@kernal-blekkie/ui",
  "version": "0.0.1-alpha.2",
  "description": "Kernal dashboard UI components",
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./dist/index.css": "./dist/index.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "react-dom": ">=18",
    "react-force-graph-2d": ">=1.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "lucide-react": "^1.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  }
}
